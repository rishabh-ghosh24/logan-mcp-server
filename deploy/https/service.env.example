# Public DNS name presented to clients. The path must be exactly /mcp.
LOGAN_HTTP_PUBLIC_URL=https://logan-mcp.example.com/mcp

# The token value belongs only in this mode-0600 file.
LOGAN_HTTP_TOKEN_FILE=/home/opc/.oci-logan-mcp/http/bearer-token

# Fixed query scope. Subcompartments are always disabled by the server.
LOGAN_HTTP_COMPARTMENT_ID=ocid1.compartment.oc1..replace_me
LOGAN_HTTP_USER=https.client

# OCI configuration used by the existing Logan backend.
OCI_LA_AUTH_TYPE=instance_principal
OCI_LA_QUERY_LOGGING=false

# Optional hard limits. Compiled ceilings are 100 rows and 1,440 minutes.
LOGAN_HTTP_MAX_RESULTS=100
LOGAN_HTTP_MAX_WINDOW_MINUTES=1440
LOGAN_HTTP_MAX_QUERY_ATTEMPTS=100
LOGAN_HTTP_QUERY_TIMEOUT_SECONDS=60
